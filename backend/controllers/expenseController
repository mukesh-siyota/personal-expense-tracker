import Expense from "../models/Expense.js"

const expenseController = {
    async addExpenses(req, res) {
         const body = req.body
         await Expense.create(body)
        res.send({
            message:"Success! New record created."
        })
    },
    async getExpense(req, res) {
        const params = req.params
        const record = await Expense.findById(params.id);
        data : record
        res.send({
            message : "Success! record found."
        })
    },
   async getExpenses(req, res) {
        const records = await Expense.find()
        data : records
        res.send({
            message : "Success! records found."
        })
    },
    async updateExpenses(req, res) {
        const params = req.params
        const updateRecord = await Expense.findByIdAndUpdate()
        res.send({
            message : "Success! records updated."
        })
    },
    async deleteExpenses(req, res) {
        const params = req.params
        const deleteRecord = await Expense.findByIdAndDelete()
        res.send({
            message : "Success! records are deleted."
        })
    }
}

export default expenseController